# Copy this file to .env and fill in your values
# cp .env.example .env

# ==================== DATABASE ====================
# Option 1: SQLite (easiest for local dev)
DATABASE_URL=sqlite:///./brainwave.db

# Option 2: PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Supabase pooler: use port 6543 or set SUPABASE_POOLER=true to rewrite 5432 -> 6543.
SUPABASE_POOLER=false
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=5
DB_APPLICATION_NAME=brainwave_api

# ==================== SECURITY ====================
SECRET_KEY=generate-a-random-secret-key-here
ALGORITHM=HS256

# ==================== AI APIs (at least one required) ====================
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_KEY=your-gemini-api-key
# Optional: comma-separated key pool. The backend rotates when a key reaches quota.
# GOOGLE_GENERATIVE_AI_KEYS=gemini-key-1,gemini-key-2,gemini-key-3
# Text + vision model. Defaults to Google's rolling "latest stable Flash"
# alias so a pinned snapshot (e.g. gemini-2.0-flash) doesn't silently 404
# once Google retires it. Override only if you need a pinned snapshot.
# GEMINI_MODEL=gemini-flash-latest

# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional: comma-separated key pool. The backend rotates when a key reaches quota.
# GROQ_API_KEYS=groq-key-1,groq-key-2,groq-key-3
# Multimodal model used for image attachments in AI Chat, tried before Gemini
# falls back to it. Groq has repeatedly decommissioned vision models (llama-4
# scout/maverick, llama-3.2-*-vision-preview) -- if image analysis logs show
# "Groq: ... does not exist or you do not have access to it", check
# https://console.groq.com/docs/models for a current vision-capable model id,
# or leave this unset/stale: Gemini is tried first and is the primary path.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Daily budget per key tracked by the backend (an internal cost-safety cap on
# top of whatever quota the provider itself gives you -- not a provider limit).
# It's shared across every user hitting that key, so size it for real traffic:
# one image analysis alone costs ~3,000-6,000 tokens (image + Gemini's
# internal "thinking" + answer). Provider-specific values override this.
AI_KEY_DAILY_TOKEN_LIMIT=1000000
# GEMINI_DAILY_TOKEN_LIMIT=1000000
# GROQ_DAILY_TOKEN_LIMIT=1000000

# OpenAI-compatible high-school/context provider pool, if enabled.
# HS_CONTEXT_API_KEYS=key-1,key-2
# HS_CONTEXT_DAILY_TOKEN_LIMIT=1000000

# ==================== GOOGLE OAUTH ====================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id

# ==================== STORAGE ====================
STORAGE_TYPE=local
STORE_ORIGINAL_FILES=false
UPLOAD_DIR=uploads
# For production redundancy, use S3 for uploads/files:
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=your-cerbyl-uploads-bucket
# AWS_REGION=us-east-2
# Optional when using IAM roles on EC2; required only for local/dev credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional public CDN/CloudFront base URL. If omitted, backend returns presigned S3 URLs.
# AWS_S3_PUBLIC_URL=
# AWS_S3_PRESIGNED_URL_TTL=900

# ==================== ADMIN ====================
# Comma-separated list of admin emails (required for admin analytics endpoints)
ADMIN_EMAILS=admin@example.com
# Comma-separated list allowed to see API key usage.
API_USAGE_ADMIN_EMAILS=aditya.s.lanka@gmail.com,rithvikkumar35@gmail.com

# ==================== DEPLOYMENT ====================
# Set to "production" to enable production-only safeguards (PostgreSQL required, CORS locked down)
ENVIRONMENT=development

# ==================== OTP DELIVERY ====================
# Email OTPs use SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, and
# SMTP_FROM_EMAIL. SMS OTPs are delivered by Twilio. Use an E.164 sender and
# recipient format, for example +14155552671. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated allowed origins (production only — ignored in development)
ALLOWED_ORIGINS=https://yourdomain.com
ALLOW_VERCEL_PREVIEW_ORIGINS=false
APP_BASE_URL=https://yourdomain.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_POWER_MONTHLY=
STRIPE_PRICE_POWER_YEARLY=

# ==================== FIREBASE (optional) ====================
# Required only if using Firebase Authentication
# FIREBASE_PROJECT_ID=your-firebase-project-id
#
# /firebase-auth verifies the client's Firebase ID token one of two ways:
#   - firebase-admin SDK + ApplicationDefault() credentials (needs either
#     GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key file,
#     or running on GCP with its metadata service -- neither is true on a
#     plain EC2/Azure/other-cloud box, and it fails with "Your default
#     credentials were not found").
#   - Google's public keys directly (google-auth's verify_firebase_token),
#     which needs no credentials at all -- just internet access.
# In production (ENVIRONMENT=production) with FIREBASE_AUTH_VERIFY_MODE unset
# or "auto", it always picks the firebase-admin path, so on a host with no
# GCP service-account key this crashes production Google sign-in with a 401.
# Set FIREBASE_AUTH_VERIFY_MODE=public-keys to use the credential-free path
# instead (this is what production runs on AWS EC2 today).
# FIREBASE_AUTH_VERIFY_MODE=public-keys

# ==================== OPTIONAL ====================
# Inactivity reminders (comma-separated hours)
# Example: 24,72,168 for 1 day, 3 days, 7 days
INACTIVITY_NOTIFICATION_HOURS=72,168

# YouTube Data API v3 (optional - for enhanced video metadata)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# yt-dlp cloud hardening (optional, useful for Azure/AWS/GCP)
# If YouTube blocks server IP with sign-in/bot challenge, provide one of:
# 1) Path to Netscape cookie file mounted in container
# YTDLP_COOKIES_FILE=/app/secrets/youtube_cookies.txt
# 2) Base64-encoded Netscape cookie file content
# YTDLP_COOKIES_B64=
#
# Optional network settings
# YTDLP_PROXY_URL=
# YTDLP_USER_AGENT=
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=android,web,ios

# RapidAPI YouTube Transcript (REQUIRED for YouTube features in production)
# Get from: https://rapidapi.com/solid-api-solid-api-default/api/youtube-transcriptor
# Free tier: 500 requests/month, Basic: $10/month for 10,000 requests
RAPIDAPI_KEY=your-rapidapi-key

# ASSEMBLYAI_API_KEY=your-assemblyai-key
# HUGGINGFACE_API_KEY=your-huggingface-key
