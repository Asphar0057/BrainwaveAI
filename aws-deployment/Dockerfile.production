FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN python -m pip install --no-cache-dir --upgrade "pip>=26.1.2" "setuptools>=78.1.1"
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download embedding models at build time: HF_HUB_OFFLINE=1/TRANSFORMERS_OFFLINE=1
# are set at runtime for reliability, so these must already be cached in the image
# or vector_store's lazy init fails permanently (no network fallback in prod).
RUN python -c "from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('BAAI/bge-small-en-v1.5'); \
    SentenceTransformer('all-MiniLM-L6-v2')"

COPY . .

RUN mkdir -p uploads attachments exports .chroma_data cache/transcripts

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ready || exit 1

CMD ["gunicorn", "main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "-"]
